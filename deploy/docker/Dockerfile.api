FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY src/Contoso.Domain/Contoso.Domain.csproj src/Contoso.Domain/
COPY src/Contoso.Application/Contoso.Application.csproj src/Contoso.Application/
COPY src/Contoso.Infrastructure/Contoso.Infrastructure.csproj src/Contoso.Infrastructure/
COPY src/Contoso.Api/Contoso.Api.csproj src/Contoso.Api/
RUN dotnet restore src/Contoso.Api/Contoso.Api.csproj

COPY . .
RUN dotnet publish src/Contoso.Api/Contoso.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime
WORKDIR /app
RUN adduser --disabled-password --no-create-home --uid 10001 contoso
USER 10001
COPY --from=build /app .
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/healthz || exit 1
ENTRYPOINT ["dotnet", "Contoso.Api.dll"]
